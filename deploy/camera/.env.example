# 85pi の ~/imx519_edge/deploy/camera/.env（コミットしない）

# Tailscale の認証キー（Settings → Keys → Generate auth key。Reusable: オフ、Pre-approved: オン、Tags: tag:camera）
TS_AUTHKEY=

# Cloudflare の API トークン（85-store.com の DNS の編集だけ）。85store-cms の .env と同じものでよい
CLOUDFLARE_API_TOKEN=

# 撮影アプリを 85pi 以外で動かすときだけ書く（その機械の tailscale serve の :12443）
# EDGE_UPSTREAM=https://<機械の名前>.<tailnet>.ts.net:12443
